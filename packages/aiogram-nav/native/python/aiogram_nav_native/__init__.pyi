from typing import Any

API_VERSION: int
ENGINE_VERSION: str

class Registry:
    def __init__(self, raw: str) -> None: ...
    def ancestors(self, id: str) -> list[str]: ...
    def root_for(self, id: str) -> str: ...
    def back_target(self, id: str) -> str | None: ...
    def cancel_target(self, id: str) -> str: ...
    def resolve(self, id: str) -> str: ...
    def node_count(self) -> int: ...

def strict_loads(raw: str, max_bytes: int = ..., max_depth: int = ...) -> Any: ...
def validate_json(raw: str, max_bytes: int = ..., max_depth: int = ...) -> None: ...
def fingerprint_canonical(raw: str) -> str: ...
def transition_history(
    history_json: str,
    current_entry_json: str | None,
    mode: str,
    limit: int,
    pop: int = ...,
    push_current: bool = ...,
) -> str: ...
def transition_state(
    old_json: str | None, node_id: str, params_changed: bool, accepted_activity: bool, now_ms: str
) -> str: ...
def token_matches(
    token_key: str,
    current_key: str,
    token_actor: str,
    actor: str,
    token_session: str,
    current_session: str,
    token_view: str,
    current_view: str,
    expires_at: str,
    now_ms: str,
) -> bool: ...
